{
  "info": {
    "name": "Full-Stack Online Bus Booking System API",
    "description": "Postman API Collection for Online Bus Booking System (Node.js, Express, MySQL, React)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "User Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"phone\": \"9876543299\",\n  \"password\": \"user123\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/register", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"user123\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@busbooking.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Get User Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "http://localhost:5000/api/auth/profile", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "auth", "profile"] }
          }
        }
      ]
    },
    {
      "name": "2. Buses",
      "item": [
        {
          "name": "Get All Buses",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/buses", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "buses"] }
          }
        },
        {
          "name": "Get Bus by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/buses/1", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "buses", "1"] }
          }
        },
        {
          "name": "Admin Create Bus",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bus_number\": \"GJ-01-XX-9999\",\n  \"bus_name\": \"Volvo Super Luxury\",\n  \"operator_name\": \"Express Connect\",\n  \"bus_type\": \"Volvo AC\",\n  \"total_seats\": 30,\n  \"amenities\": \"WiFi, Charging, Water\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/buses", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "buses"] }
          }
        }
      ]
    },
    {
      "name": "3. Routes & Search",
      "item": [
        {
          "name": "Get All Routes",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/routes", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "routes"] }
          }
        },
        {
          "name": "Search Buses",
          "request": {
            "method": "GET",
            "url": {
              "raw": "http://localhost:5000/api/search?from=Ahmedabad&to=Mumbai&date=2026-10-15",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "search"],
              "query": [
                { "key": "from", "value": "Ahmedabad" },
                { "key": "to", "value": "Mumbai" },
                { "key": "date", "value": "2026-10-15" }
              ]
            }
          }
        },
        {
          "name": "Get Schedule Seats Layout",
          "request": {
            "method": "GET",
            "url": { "raw": "http://localhost:5000/api/schedules/1/seats", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "schedules", "1", "seats"] }
          }
        }
      ]
    },
    {
      "name": "4. Bookings & Payments",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schedule_id\": 1,\n  \"passengers\": [\n    {\n      \"seat_number\": \"A1\",\n      \"passenger_name\": \"John Doe\",\n      \"age\": 28,\n      \"gender\": \"Male\"\n    }\n  ],\n  \"payment_method\": \"UPI\"\n}"
            },
            "url": { "raw": "http://localhost:5000/api/bookings", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Get User Bookings",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "http://localhost:5000/api/bookings", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "bookings"] }
          }
        },
        {
          "name": "Cancel Booking",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwt_token}}" }],
            "url": { "raw": "http://localhost:5000/api/bookings/1/cancel", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "bookings", "1", "cancel"] }
          }
        }
      ]
    },
    {
      "name": "5. Admin Panel APIs",
      "item": [
        {
          "name": "Get Admin Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }],
            "url": { "raw": "http://localhost:5000/api/admin/dashboard", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "admin", "dashboard"] }
          }
        },
        {
          "name": "Get Admin Users List",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{admin_jwt_token}}" }],
            "url": { "raw": "http://localhost:5000/api/admin/users", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "admin", "users"] }
          }
        }
      ]
    }
  ]
}
